{
  "services": [
    {
      "name": "postgres",
      "image": "postgres:14",
      "restart": "unless-stopped",
      "environment": {
        "POSTGRES_USER": "${POSTGRES_USER}",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD}",
        "POSTGRES_DB": "${POSTGRES_DB}"
      },
      "volumes": [
        {
          "hostPath": "odk-postgres-data",
          "containerPath": "/var/lib/postgresql/data"
        }
      ]
    },
    {
      "name": "redis",
      "image": "redis:7",
      "restart": "unless-stopped"
    },
    {
      "name": "odk-central",
      "image": "getodk/central:latest",
      "restart": "unless-stopped",
      "depends_on": ["postgres", "redis"],
      "environment": {
        "DOMAIN": "${ODK_HOST}",
        "HTTPS": "true",
        "SYSADMIN_EMAIL": "${SYSADMIN_EMAIL}",
        "SYSADMIN_PASSWORD": "${SYSADMIN_PASSWORD}",
        "DB_HOST": "postgres",
        "DB_USER": "${POSTGRES_USER}",
        "DB_PASSWORD": "${POSTGRES_PASSWORD}",
        "DB_NAME": "${POSTGRES_DB}",
        "REDIS_HOST": "redis",
        "ENCRYPTION_SECRET": "${ENCRYPTION_SECRET}"
      },
      "volumes": [
        {
          "hostPath": "odk-central-data",
          "containerPath": "/data"
        }
      ],
      "networking": {
        "type": "http",
        "port": 8383,
        "https": true,
        "host": "${ODK_HOST}"
      }
    }
  ],
  "volumes": {
    "odk-postgres-data": {},
    "odk-central-data": {}
  }
}

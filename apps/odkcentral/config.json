{
  "name": "ODK Central",
  "id": "odk-central",
  "version": "1.0.0",
  "tipi_version": 3,
  "available": true,
  "port": 32179,
  "exposable": true,
  "dynamic_config": true,
  "author": "lochland",
  "source": "https://github.com/Lochllama-26/lochland",
  "short_desc": "ODK Central server for ODK Collect",
  "description": "Deploys ODK Central with PostgreSQL, Redis, and HTTPS via Traefik.",
  "supported_architectures": ["amd64", "arm64"],
  "form_fields": [
    {
      "type": "fqdn",
      "label": "Hostname",
      "description": "Public HTTPS hostname for ODK Central (e.g. odk.example.com)",
      "required": true,
      "env_variable": "ODK_HOST"
    },
    {
      "type": "email",
      "label": "Sysadmin Email",
      "required": true,
      "env_variable": "SYSADMIN_EMAIL"
    },
    {
      "type": "password",
      "label": "Sysadmin Password",
      "required": true,
      "env_variable": "SYSADMIN_PASSWORD",
      "min": 8
    },
    {
      "type": "text",
      "label": "PostgreSQL Username",
      "required": true,
      "env_variable": "POSTGRES_USER",
      "default": "odk"
    },
    {
      "type": "password",
      "label": "PostgreSQL Password",
      "required": true,
      "env_variable": "POSTGRES_PASSWORD",
      "min": 8
    },
    {
      "type": "text",
      "label": "PostgreSQL Database",
      "required": true,
      "env_variable": "POSTGRES_DB",
      "default": "odk"
    },
    {
      "type": "random",
      "label": "Encryption Secret",
      "description": "Long random string used to encrypt sensitive data",
      "required": true,
      "env_variable": "ENCRYPTION_SECRET",
      "min": 32
    }
  ]
}

{
  "name": "ODK Central",
  "id": "odk-central",
  "version": "1.0.0",
  "tipi_version": 3,
  "available": true,
  "short_desc": "ODK Central server for ODK Collect",
  "description": "Deploys ODK Central with HTTPS via Traefik",
  "supported_architectures": ["amd64", "arm64"],
  "form_fields": [
    {
      "type": "fqdn",
      "label": "Hostname",
      "description": "Fully qualified domain name for ODK Central",
      "required": true,
      "env_variable": "ODK_HOST"
    },
    {
      "type": "email",
      "label": "Sysadmin Email",
      "required": true,
      "env_variable": "SYSADMIN_EMAIL"
    },
    {
      "type": "password",
      "label": "Sysadmin Password",
      "required": true,
      "env_variable": "SYSADMIN_PASSWORD",
      "min": 8
    },
    {
      "type": "text",
      "label": "PostgreSQL Username",
      "required": true,
      "env_variable": "POSTGRES_USER",
      "default": "odk"
    },
    {
      "type": "password",
      "label": "PostgreSQL Password",
      "required": true,
      "env_variable": "POSTGRES_PASSWORD",
      "min": 8
    },
    {
      "type": "text",
      "label": "PostgreSQL Database",
      "required": true,
      "env_variable": "POSTGRES_DB",
      "default": "odk"
    },
    {
      "type": "random",
      "label": "Encryption Secret",
      "description": "Secret for encryption keys",
      "required": true,
      "env_variable": "ENCRYPTION_SECRET",
      "min": 32
    }
  ]
}
